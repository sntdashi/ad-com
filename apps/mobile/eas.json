{
    "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
    "build": {
        "preview": {
            "distribution": "internal",
            "env": { "EXPO_PUBLIC_APP_VARIANT": "preview" },
            "android": { "buildType": "apk" }
        },
        "production": {
            "env": { "EXPO_PUBLIC_APP_VARIANT": "production" },
            "android": { "buildType": "app-bundle" }
        }
    }
}
